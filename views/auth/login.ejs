<div class="m-0 w-100 bg-img-2">
  <!-- Animated Background Elements -->
  <div class="animated-background">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
    <div class="shape shape-5"></div>
  </div>

  <form
    action="/auth/login"
    method="POST"
    class="login-form">

    <div class="text-center mb-4">
      <div class="brand-badge">
        <i class="bi bi-egg-fried"></i>
      </div>
      <h2 class="fw-bold title-animated">Welcome Back</h2>
      <p class="text-muted mt-2 mb-0">
        Access your Meal Share account.
      </p>
    </div>

    <div class="mb-4 position-relative input-wrapper input-group-animated">
      <label for="email" class="form-label">Email address</label>
      <div class="input-group input-animated">
        <span class="input-group-text bg-transparent border-end-0">
          <i class="bi bi-envelope-fill"></i>
        </span>
        <input type="email" name="email" class="form-control border-start-0 ps-0" id="email" placeholder="Enter email..." required autofocus>
      </div>
      <div class="input-focus-bg"></div>
      <div class="input-focus-effect"></div>
    </div>

    <div class="mb-2 position-relative input-wrapper input-group-animated">
      <label for="password" class="form-label">Password</label>
      <div class="input-group input-animated">
        <span class="input-group-text bg-transparent border-end-0">
          <i class="bi bi-lock-fill"></i>
        </span>
        <input type="password" name="password" class="form-control border-start-0 ps-0" id="password" placeholder="Enter password..." required>
        <span class="input-group-text bg-transparent border-start-0 password-toggle">
          <i class="bi bi-eye-slash-fill"></i>
        </span>
      </div>
      <div class="input-focus-bg"></div>
      <div class="input-focus-effect"></div>
      <div class="form-text text-end mt-2">
        <a href="/auth/forgot-password" class="text-decoration-none link-hover">Forgot password?</a>
      </div>
    </div>

    <button type="submit" class="submit-btn">
      <i class="fas fa-sign-in-alt me-2"></i>
      Login
    </button>

    <div class="text-center divider">
      <span>OR</span>
    </div>

    <div class="social-login mb-4">
      <button type="button" class="social-btn google-btn" aria-label="Continue with Google">
        <i class="bi bi-google"></i>
      </button>
      <button type="button" class="social-btn facebook-btn" aria-label="Continue with Facebook">
        <i class="bi bi-facebook"></i>
      </button>
      <button type="button" class="social-btn twitter-btn" aria-label="Continue with Twitter">
        <i class="bi bi-twitter"></i>
      </button>
    </div>

    <div class="text-center signup-text login-link">
      <span>Don't have an account?</span>
      <a href="/auth/signup" class="text-primary fw-bold ms-1 link-hover">Sign up here</a>
    </div>
  </form>
</div>
