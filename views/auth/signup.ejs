<div class="m-0 w-100 bg-img-2">
	<!-- Animated Background Elements -->
	<div class="animated-background">
		<div class="shape shape-1"></div>
		<div class="shape shape-2"></div>
		<div class="shape shape-3"></div>
		<div class="shape shape-4"></div>
		<div class="shape shape-5"></div>
	</div>

	<form action="/auth/signup" method="POST" class="login-form">

		<div class="text-center mb-4">
			<div class="brand-badge">
				<i class="bi bi-person-plus-fill"></i>
			</div>
			<h3 class="title-animated">Create your account</h3>
			<p class="form-subtitle mt-2 mb-0">Join Meal Share and start sharing meals.</p>
		</div>

		<% if (typeof errors != 'undefined') { %>
			<% errors.forEach(function(error) { %>
				<div class="alert alert-danger alert-dismissible fade show" role="alert">
					<i class="bi bi-exclamation-triangle-fill me-1"></i>
					<%= error.msg %>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			<% }); %>
		<% } %>

		<div class="form-row-split">
			<div class="field-group">
				<label for="first-name" class="form-label">First name</label>
				<div class="input-wrapper">
					<div class="input-group input-animated">
						<span class="input-group-text bg-transparent border-end-0">
							<i class="bi bi-person-fill"></i>
						</span>
						<input type="text" name="firstName" class="form-control border-start-0 ps-0" id="first-name" placeholder="Enter first name.." value="<%= typeof firstName != 'undefined' ? firstName : '' %>" required autofocus>
					</div>
					<div class="input-focus-effect"></div>
				</div>
			</div>

			<div class="field-group">
				<label for="last-name" class="form-label">Last name</label>
				<div class="input-wrapper">
					<div class="input-group input-animated">
						<span class="input-group-text bg-transparent border-end-0">
							<i class="bi bi-person-fill"></i>
						</span>
						<input type="text" name="lastName" class="form-control border-start-0 ps-0" id="last-name" placeholder="Enter last name.." value="<%= typeof lastName != 'undefined' ? lastName : '' %>" required>
					</div>
					<div class="input-focus-effect"></div>
				</div>
			</div>
		</div>

		<div class="field-group">
			<label for="email" class="form-label">Email address</label>
			<div class="input-wrapper">
				<div class="input-group input-animated">
					<span class="input-group-text bg-transparent border-end-0">
						<i class="bi bi-envelope-fill"></i>
					</span>
					<input type="email" name="email" class="form-control border-start-0 ps-0" id="email" placeholder="Enter email.." value="<%= typeof email != 'undefined' ? email : '' %>" required>
				</div>
				<div class="input-focus-effect"></div>
			</div>
			<div class="form-text secure-text"><i class="bi bi-shield-lock"></i> We'll never share your email with anyone else.</div>
		</div>

		<div class="field-group">
			<label for="password1" class="form-label">Password</label>
			<div class="input-wrapper">
				<div class="input-group input-animated">
					<span class="input-group-text bg-transparent border-end-0">
						<i class="bi bi-lock-fill"></i>
					</span>
					<input type="password" name="password1" class="form-control border-start-0 ps-0" id="password1" placeholder="Enter password.." value="<%= typeof password1 != 'undefined' ? password1 : '' %>" required>
					<span class="input-group-text bg-transparent border-start-0 password-toggle" data-target="password1" role="button" tabindex="0" aria-label="Show password">
						<i class="bi bi-eye-slash-fill"></i>
					</span>
				</div>
				<div class="input-focus-effect"></div>
			</div>
			<div class="password-strength-meter mt-2">
				<div class="strength-bar" id="passwordStrength"></div>
			</div>
			<span class="strength-label" id="passwordStrengthLabel"></span>
		</div>

		<div class="field-group">
			<label for="password2" class="form-label">Confirm password</label>
			<div class="input-wrapper">
				<div class="input-group input-animated">
					<span class="input-group-text bg-transparent border-end-0">
						<i class="bi bi-lock-fill"></i>
					</span>
					<input type="password" name="password2" class="form-control border-start-0 ps-0" id="password2" placeholder="Re-enter password.." value="<%= typeof password2 != 'undefined' ? password2 : '' %>" required>
					<span class="input-group-text bg-transparent border-start-0 password-toggle" data-target="password2" role="button" tabindex="0" aria-label="Show password">
						<i class="bi bi-eye-slash-fill"></i>
					</span>
				</div>
				<div class="input-focus-effect"></div>
			</div>
			<div class="match-indicator" id="passwordMatch">
				<i class="bi bi-check-circle-fill"></i>
				<span></span>
			</div>
		</div>

		<div class="field-group">
			<label for="role" class="form-label">Signup as</label>
			<div class="input-wrapper">
				<div class="input-group input-animated">
					<span class="input-group-text bg-transparent border-end-0">
						<i class="bi bi-people-fill"></i>
					</span>
					<select class="form-select border-start-0 ps-0" name="role" id="role">
						<option value="donor">Donor</option>
						<option value="agent">Agent</option>
						<option value="admin">Admin</option>
					</select>
				</div>
				<div class="input-focus-effect"></div>
			</div>
		</div>

		<button type="submit" class="submit-btn mt-4">
			<i class="bi bi-person-check-fill me-1"></i>
			Create account
		</button>

		<div class="mt-4 text-center login-link">
			<span>Already have an account?</span>
			<a href="/auth/login">Login here</a>
		</div>
	</form>
</div>
